# Khandaq deployment environment. Copy to .env and fill in. Production refuses placeholder values.

# --- Core ---
KHANDAQ_ENV=dev                       # dev | prod
KHANDAQ_PUBLIC_URL=http://localhost:8080

# --- Database (PostgreSQL 17) ---
KHANDAQ_DATABASE_URL=postgresql+psycopg://khandaq_app:changeme@postgres:5432/khandaq
KHANDAQ_MIGRATION_DATABASE_URL=postgresql+psycopg://khandaq:changeme@postgres:5432/khandaq

# --- Secrets (generate; never commit real values) ---
KHANDAQ_SESSION_SECRET=generate-with-openssl-rand-base64-48
# Envelope key that encrypts captured evidence at rest (ADR-0006). BACK THIS UP SEPARATELY.
KHANDAQ_EVIDENCE_KEY=generate-with-openssl-rand-base64-32

# --- Evidence object store (S3-compatible; RustFS locally) ---
KHANDAQ_OBJECT_STORE_URL=s3://khandaq-evidence
KHANDAQ_OBJECT_STORE_ENDPOINT=http://rustfs:9000
KHANDAQ_OBJECT_STORE_ACCESS_KEY_ID=khandaq-evidence-key
KHANDAQ_OBJECT_STORE_SECRET_ACCESS_KEY=changeme
KHANDAQ_SIGSTORE=off                  # off | on (optional external signing of the evidence ledger root)

# --- Identity (OIDC via Keycloak; spec 008 / ADR-0005). ---
# In prod (KHANDAQ_ENV=prod) the API refuses to start unless ISSUER, CLIENT_SECRET and PUBLIC_URL are
# set — OIDC is the only login path there (the dev header stub is disabled in prod). Point ISSUER at
# the Keycloak realm (…/realms/khandaq) and set CLIENT_SECRET from the khandaq-api client credentials;
# import deploy/keycloak/khandaq-realm.json first. The first login whose email equals ADMIN_EMAIL
# becomes the org admin.
KHANDAQ_OIDC_ISSUER=
KHANDAQ_OIDC_CLIENT_ID=khandaq-api
KHANDAQ_OIDC_CLIENT_SECRET=
KHANDAQ_ADMIN_EMAIL=you@example.org

# --- Worker / adapter execution (ADR-0009) ---
KHANDAQ_ROLE=api                      # api | worker
KHANDAQ_ADAPTER_RUNTIME=docker-socket # docker-socket (shape A) | runner-host (shape B)
KHANDAQ_ADAPTER_REGISTRY=ghcr.io/sira-labs
# Default-deny egress for adapter containers is enforced by the runtime; adapters only reach the
# resolved in-scope target of their run.
