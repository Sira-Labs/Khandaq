# Khandaq deployment environment. Copy to .env and fill in. Production refuses placeholder values.

# --- Core ---
KHANDAQ_ENV=dev                       # dev | prod
KHANDAQ_PUBLIC_URL=http://localhost:8080

# --- Database (PostgreSQL 17) ---
# Two logins. Migrations run as the owner (khandaq). The API and worker use khandaq_app, which the
# API creates on every boot with row access only: it cannot rewrite or truncate the append-only
# audit/evidence/ledger tables, nor disable their triggers. Give it its own password.
KHANDAQ_DATABASE_URL=postgresql+psycopg://khandaq_app:changeme-app@postgres:5432/khandaq
KHANDAQ_MIGRATION_DATABASE_URL=postgresql+psycopg://khandaq:changeme@postgres:5432/khandaq

# --- Secrets (generate; never commit real values) ---
KHANDAQ_SESSION_SECRET=generate-with-openssl-rand-base64-48
# Envelope key that encrypts captured evidence at rest (ADR-0006/0016): any string of at least 32
# characters. BACK THIS UP SEPARATELY: without it, stored evidence cannot be decrypted.
KHANDAQ_EVIDENCE_KEY=generate-with-openssl-rand-base64-32
# Rotation: put the new key above and move the old one here (comma-separated). Old objects are never
# re-encrypted, so keep a retired key listed as long as evidence written under it is kept.
KHANDAQ_EVIDENCE_PREVIOUS_KEYS=

# --- Evidence object store (S3-compatible; RustFS locally; spec 014) ---
# The bundled RustFS's root credentials (the compose file passes them to the rustfs service).
RUSTFS_ROOT_KEY=khandaq-root
RUSTFS_ROOT_SECRET=changeme
# Evidence goes to this bucket, encrypted and write-once. The worker creates the bucket (with
# versioning) on first use if the key may; otherwise create it yourself. Empty URL = keep evidence
# in the worker's KHANDAQ_EVIDENCE_DIR volume instead.
KHANDAQ_OBJECT_STORE_URL=s3://khandaq-evidence
KHANDAQ_OBJECT_STORE_ENDPOINT=http://rustfs:9000
KHANDAQ_OBJECT_STORE_ACCESS_KEY_ID=khandaq-root       # or a bucket-scoped key (see caprover.md §4)
KHANDAQ_OBJECT_STORE_SECRET_ACCESS_KEY=changeme
KHANDAQ_SIGSTORE=off                  # off | on (optional external signing of the evidence ledger root)

# --- Identity (OIDC via Keycloak; spec 008 / ADR-0005). ---
# In prod (KHANDAQ_ENV=prod) the API refuses to start unless ISSUER, CLIENT_SECRET and PUBLIC_URL are
# set — OIDC is the only login path there (the dev header stub is disabled in prod). Point ISSUER at
# the Keycloak realm (…/realms/khandaq) and set CLIENT_SECRET from the khandaq-api client credentials;
# import deploy/keycloak/khandaq-realm.json first. The first login whose email equals ADMIN_EMAIL
# becomes the org admin.
KHANDAQ_OIDC_ISSUER=
KHANDAQ_OIDC_CLIENT_ID=khandaq-api
KHANDAQ_OIDC_CLIENT_SECRET=
KHANDAQ_ADMIN_EMAIL=you@example.org
# Who else may sign in (comma-separated). The realm brokers ANY Google/GitHub account, so everyone
# not listed here (and not ADMIN_EMAIL) is refused. Empty = only the admin.
KHANDAQ_ALLOWED_EMAILS=

# --- Worker / adapter execution (ADR-0009) ---
KHANDAQ_ROLE=api                      # api | worker
KHANDAQ_ADAPTER_RUNTIME=docker-socket # docker-socket (shape A) | runner-host (shape B)
KHANDAQ_ADAPTER_REGISTRY=ghcr.io/sira-labs
# Default-deny egress for adapter containers is enforced by the runtime; adapters only reach the
# resolved in-scope target of their run (spec 012: a per-run internal network + forwarder).
# The host's docker group id, so the worker (uid 10001) may use the socket: `getent group docker`.
DOCKER_GID=
# Set on the worker only (compose sets both): the image the per-run forwarder runs from (the same
# khandaq-api image) and the Docker network targets are reachable from.
# KHANDAQ_FORWARDER_IMAGE=ghcr.io/sira-labs/khandaq-api:latest
# KHANDAQ_ADAPTER_EGRESS_NETWORK=khandaq
# KHANDAQ_ADAPTER_TIMEOUT_SECONDS=3600
